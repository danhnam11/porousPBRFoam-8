FoamFile
{
    version     2.0;
    format      ascii;
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

6
(
    inlet
    {
        type            patch;
        nFaces          50;
        startFace       19750;
    }
    outlet
    {
        type            patch;
        nFaces          50;
        startFace       19800;
    }
    heatedWall
    {
        type            wall;
        inGroups        List<word> 1(wall);
        nFaces          200;
        startFace       19850;
    }
    axis
    {
        type            empty;
        inGroups        List<word> 1(empty);
        nFaces          0;
        startFace       20050;
    }
    front
    {
        type            wedge;
        inGroups        List<word> 1(wedge);
        nFaces          10000;
        startFace       20050;
    }
    back
    {
        type            wedge;
        inGroups        List<word> 1(wedge);
        nFaces          10000;
        startFace       30050;
    }
)

