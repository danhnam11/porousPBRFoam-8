FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "rho.*"
    {
        solver           PCG;
        preconditioner   DIC;
        tolerance        1e-6;
        relTol           0.1;
	minIter		 2;
    }

    p
    {
        solver           PCG;
        preconditioner   DIC;
        tolerance        1e-6;
        relTol           0.1;
	minIter		 2;
    }

    pFinal
    {
        $p;
        tolerance        1e-6;
        relTol           0.0;
	minIter		 2;
    }

    "(U|h|e)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0.1;
	minIter		2;
    }

    "(U|h|e)Final"
    {
        $U;
        relTol          0;
	minIter		2;
    }

    "Yi.*"
    {
        $hFinal;
	minIter		2;
    }
}

PIMPLE
{
    momentumPredictor no;
    nOuterCorrectors  1;
    nCorrectors     2;
    nNonOrthogonalCorrectors 0;
