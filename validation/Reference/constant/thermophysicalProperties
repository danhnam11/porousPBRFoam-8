FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         multiComponentMixture;
    transport       const;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

inertSpecie N2;

#include "thermo.catalyst.gas";


mixture
{
    specie
    {
        molWeight       28.97;
    }
    equationOfState
    {
        rho             1.06;
    }
    thermodynamics
    {
        Cp              1008;
        Hf              0;
    }
    transport
    {
        mu              1.999e-05;
        Pr              0.71;
    }
}

