FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      porousMediaProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
solverMode      	     			PM;

// Solid Thermophysical properties
SolidThermalConductivity     			1.175;   // [W/m-K]
SolidDensity                 			2719;   // [kg/m3]
SolidHeatCapacity            			871;    // [J/kg-K]

// Porous Media geometric properties
Porosity                     			0.4165; // [-]
ParticleDiameter             			5e-3;   // [m]
ReactorDiameter           	   		4.1e-2; // [m]
SuperficialVelocity          			1.51;  // [m/s]

// Porous Media closure model
pressureDropClosureModel			Darcy;
ThermalConductivityClosureModel 		Const;
DiffusivityClosureModel				BruggemanWilhelm;
WallHeatTransferClosureModel                    Const;

DarcyCoeff					0.0;
EffectiveThermalConductivity  			0.7;
EffectiveRadialThermalConductivity  		0.7;
EffectiveAxialThermalConductivity   		2.0;
AxialDirection                      		(1 0 0);
heatTransferCoefficient				100;
// ************************************************************************* //
