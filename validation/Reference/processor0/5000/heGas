FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "5000";
    object      heGas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 100517;

boundaryField
{
    inlet
    {
        type            fixedEnergy;
        value           nonuniform List<scalar> 0();
    }
    wall
    {
        type            mixedEnergy;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 0;
        value           uniform 100517;
    }
    outlet
    {
        type            gradientEnergy;
        gradient        nonuniform List<scalar> 0();
        value           nonuniform List<scalar> 0();
    }
    axis
    {
        type            empty;
    }
    back
    {
        type            wedge;
    }
    front
    {
        type            wedge;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform 100517;
    }
    procBoundary0to3
    {
        type            processor;
        value           uniform 100517;
    }
}


