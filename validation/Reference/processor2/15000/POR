FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "15000";
    object      POR;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.4165;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    wall
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    axis
    {
        type            empty;
    }
    back
    {
        type            wedge;
    }
    front
    {
        type            wedge;
    }
    procBoundary2to3
    {
        type            processor;
        value           uniform 0.4165;
    }
}


